{
    "default": "defaultContext",
    "context": [
        {
            "name": "defaultContext",
            "gateway": {
                "activate": ["REST", "RabbitMQ"]
            },
            "digitalTwin": {
                "allowEvents": true,
                "host": "localhost",
                "port": 8080,
                "useHttps": false,
                "rabbitMQConnection": "amqp://user:password@localhost:5672",
                "inboutQueue": "inboundQueue",
                "outboundQueue": "outboundQueue"            
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["maintance_prep:$model.read.*", "maintance_prep:$data.*.*"]
                    }
                }
            },
            "services": {
                "maintance_prep": {
                    "host": "localhost",
                    "port": 8080,
                    "useHttps": false
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": false
                }
            }
        }
    ]
}