{
    "default": "defaultContext",
    "context": [
        {
            "name": "defaultContext",
            "gateway": {
                "activate": ["REST"]
            },
            "digitalTwin": {
                "allowEvents": true,
                "host": "localhost",
                "port": 8080,
                "useHttps": false,
                "rabbitMQConnection": "amqp://user:password@localhost:5672",
                "inboundQueue": "inboundQueue",
                "outboundQueue": "outboundQueue"            
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["weather:$model.read.*", "weather:$data.*.*"]
                    }
                }
            },
            "services": {
                "weather": {
                    "host": "localhost",
                    "port": 8086,
                    "useHttps": false
                },
                "auth": {
                    "host": "localhost",
                    "port": 8088,
                    "useHttps": false
                }
            }
        }
    ]
}