{
    "default": "defaultContext",
    // each context is a DT. 
    "context": [
        {
            "name": "defaultContext",
            "gateway": {
                "activate": ["REST"]
            },
            // resolvers are used to dynamically load in service and event configs
            "resolver": {
                "service": {
                    "host": "localhost",
                    "port": 8082,
                    "useHttps": false
                },
                "events": {
                    "host": "localhost",
                    "port": 8083,
                    "useHttps": false
                }
            },
            "events": {
                "myEvent": {
                    "host": "localhost",
                    "port": 8083,
                    "useHttps": false,
                    "path": "/myEvent",
                    "mode": "push" // push, pull, push-pull
                }
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["maintance_prep:$model.read.*", "maintance_prep:$data.*.*"]
                    }
                }
            },
            "services": {
                "maintance_prep": {
                    "host": "localhost",
                    "port": 8080,
                    "useHttps": false
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": false
                }
            }
        },
        {
            "name": "secondContext",
            "gateway": {
                "activate": ["REST", "RabbitMQ"]
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["super_service:$model.read.*", "super_service:$data.*.*"]
                    }
                }
            },
            "services": {
                "super_service": {
                    "host": "localhost",
                    "port": 8085,
                    "useHttps": true
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": true
                }
            }
        }
    ]
}