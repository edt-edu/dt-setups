{
    "default": "defaultContext",
    "context": [
        {
            "name": "defaultContext",
            "gateway": {
                "activate": ["REST", "RabbitMQ"]
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["maintance_prep:$model.read.*", "maintance_prep:$data.*.*"]
                    }
                }
            },
            "services": {
                "maintance_prep": {
                    "host": "localhost",
                    "port": 8080,
                    "useHttps": false
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": false
                }
            }
        },
        {
            "name": "secondContext",
            "gateway": {
                "activate": ["REST", "RabbitMQ"]
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["super_service:$model.read.*", "super_service:$data.*.*"]
                    }
                }
            },
            "services": {
                "super_service": {
                    "host": "localhost",
                    "port": 8085,
                    "useHttps": true
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": true
                }
            }
        }
    ]
}