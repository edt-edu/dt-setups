{
    "default": "defaultContext",
    "context": [
        {
            "name": "defaultContext",
            "gateway": {
                "activate": ["REST", "RabbitMQ"]
            },
            "digitalTwin": {
                "allowEvents": true,
                "host": "localhost",
                "port": 8080,
                "useHttps": false             
            },
            "auth": {
                "issuer": {
                    "basic": {
                        "service": "auth"
                    }
                },
                "rules": {
                    "files": [],
                    "static": {
                        "scope_1": ["maintance_prep:$model.read.*", "maintance_prep:$data.*.*"]
                    }
                }
            },
            "services": {
                // define the servers here as defined in openapi
                "maintance_prep": {
                    "servers": [
                        {
                            "url": "{protocol}://{host}:{port}/{basePath}",
                            "description": "The service for maintance preparation",
                            "variables": {
                                "protocol": {
                                    "default": "http",
                                    "enum": ["http", "https"]
                                },
                                "host": {
                                    "default": "localhost"
                                },
                                "port": {
                                    "default": 8080
                                },
                                "basePath": {
                                    "default": "/api/v1"
                                }
                            }
                        }
                    ],
                    "components": {
                        "parameters": {
                            "param1": {
                                "in": "query",
                                "description": "The first parameter",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                    }
                },
                "auth": {
                    "host": "localhost",
                    "port": 8081,
                    "useHttps": false
                }
            }
        }
    ]
}