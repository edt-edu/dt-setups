@startuml
' Define classes for each schema

class LocationType {
    __schema__: string
    name: string
    coordinates: Coordinates
}

class Coordinates {
    latitude: number
    longitude: number
}

class DateType {
    <<type>> string (format: date)
}

class TemperatureType {
    __schema__: string
    value: number
    unit: string <<enum: ["Celsius", "Fahrenheit"]>>
}

class HumidityType {
    __schema__: string
    value: number
    unit: string <<enum: ["Percentage"]>>
}

class WindSpeedType {
    __schema__: string
    value: number
    unit: string <<enum: ["km/h", "m/s"]>>
}

class PrecipitationType {
    __schema__: string
    value: number
    unit: string <<enum: ["mm", "inches"]>>
}

' Define relationships between classes
LocationType --> Coordinates
TemperatureType --> "unit" 
HumidityType --> "unit"
WindSpeedType --> "unit" 
PrecipitationType --> "unit"

@enduml